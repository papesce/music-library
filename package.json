{
  "name": "music-library",
  "version": "1.0.0",
  "description": "MP3 Library + Wishlist — Node + React (Vite)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:server": "tsx --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --loader tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "music-metadata": "^8.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
